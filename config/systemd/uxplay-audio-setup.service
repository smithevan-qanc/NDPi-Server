[Unit]
Description=PulseAudio null-sink setup for AirPlay-to-NDI audio capture
Documentation=file:///home/ndpi-server/ndpi/BUILD_AND_SETUP.md
After=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ndpi-server
Group=ndpi-server
# XDG_RUNTIME_DIR (needed to reach this user's PulseAudio/PipeWire-pulse
# session) comes from the shared /etc/ndpi/.env -- git-hub-deploy-server's
# install_uxplay_ndi_bridge patches that file's value to the real deployed
# user's UID automatically.
EnvironmentFile=/etc/ndpi/.env
WorkingDirectory=/home/ndpi-server/ndpi/ndi_receiver_v3__NDI6
ExecStart=/home/ndpi-server/ndpi/ndi_receiver_v3__NDI6/uxplay-audio-setup.sh

# The null sink lives in the Pulse/PipeWire server's own process, not this
# script -- if uxplay-airplay.service or pulseaudio itself gets restarted,
# re-run this on demand (systemctl restart uxplay-audio-setup) rather than
# relying on it firing again automatically.
Restart=no

[Install]
WantedBy=multi-user.target
