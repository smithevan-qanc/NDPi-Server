[Unit]
Description=AirPlay to NDI Bridge - captures virtual display :1 (+ audio) and re-broadcasts as NDI
Documentation=file:///home/ndpi-server/NDPi_Monitor__v3/Server__v3_1_0/BUILD_AND_SETUP.md
After=uxplay-xvfb.service uxplay-audio-setup.service uxplay-airplay.service network-online.target
Wants=network-online.target
# Only Xvfb is a hard dependency -- this keeps broadcasting (a black frame)
# even if uxplay itself isn't currently running/mirroring anything.
Requires=uxplay-xvfb.service
BindsTo=uxplay-xvfb.service

[Service]
Type=simple
User=ndpi-server
Group=ndpi-server
WorkingDirectory=/home/ndpi-server/NDPi_Monitor__v3/Server__v3_1_0/ndi_receiver_v3__NDI6

# Edit --width/--height here to match uxplay-xvfb.service's Xvfb screen size
# if you change it. --audio-device must match the sink_name used by
# uxplay-audio-setup.sh (default "uxplay_ndi_audio" -> ".monitor").
ExecStart=/home/ndpi-server/NDPi_Monitor__v3/Server__v3_1_0/ndi_receiver_v3__NDI6/uxplay_ndi_sender \
    --name "NDPi AirPlay" --display :1 --width 1920 --height 1080 --fps 30 \
    --audio-device uxplay_ndi_audio.monitor

# Auto-restart on failure (crash, lost X connection, pipeline error, etc.)
Restart=on-failure
RestartSec=5

# Memory and CPU limits (optional, for Raspberry Pi resource protection)
MemoryLimit=512M
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uxplay-ndi-sender

[Install]
WantedBy=multi-user.target
