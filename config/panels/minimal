# lxpanel <profile> config file. Manually editing is not recommended.
# Use preference dialog in lxpanel to adjust config when you can.

Global {
  edge=bottom
  align=right
  margin=0
  widthtype=percent
  width=100
  height=34
  transparent=1
  tintcolor=#000000
  alpha=1
  autohide=1
  heightwhenhidden=0
  autohidedelay=2000
  setdocktype=1
  setpartialstrut=1
  usefontcolor=0
  fontsize=12
  fontcolor=#333333
  usefontsize=0
  background=0
  backgroundfile=/usr/share/lxpanel/images/background.png
  iconsize=24
  monitor=0
  point_at_menu=0
  notifications=0
}
Plugin {
  type=smenu
  Config {
  }
}
Plugin {
  type=launchbar
  Config {
    Button {
      id=x-terminal-emulator.desktop
    }
  }
}
Plugin {
  type=taskbar
  expand=1
  Config {
    tooltips=0
    IconsOnly=1
    ShowAllDesks=0
    UseMouseWheel=1
    UseUrgencyHint=0
    FlatButton=0
    MaxTaskWidth=200
    spacing=0
    GroupedTasks=0
  }
}