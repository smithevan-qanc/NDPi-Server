#!/usr/bin/env bash
set -e

UPDATE_AVAILABLE=false

cd $HOME/ndpi
CURRENT_VERSION="$(head -n 1 version/current)"
CURRENT_VERSION_DATE="$(head -n 1 version/current-date)"

cd $HOME/TMP_ndpi
BRANCH="$(head -n 1 version/git)"

git fetch origin $BRANCH &>/dev/null

LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/$BRANCH)

if [ "$LOCAL" != "$REMOTE" ]; then
    git reset --hard origin/$BRANCH &>/dev/null
    chmod +x ./sh/*
fi

NEWEST_VERSION="$(head -n 1 version/current)"
NEWEST_VERSION_DATE="$(head -n 1 version/current-date)"

if [ "$CURRENT_VERSION" != "$NEWEST_VERSION" ]; then
    UPDATE_AVAILABLE=true
fi

printf "{
    \"update_available\": ${UPDATE_AVAILABLE},
    \"newest_version\": {
        \"ndpi\": \"$NEWEST_VERSION\",
        \"released\": \"$NEWEST_VERSION_DATE\",
        \"git\": \"$REMOTE\"
    },
    \"installed_version\": {
        \"ndpi\": \"$CURRENT_VERSION\",
        \"released\": \"$CURRENT_VERSION_DATE\",
        \"git\": \"$LOCAL\"
    }
}
"

exit 0