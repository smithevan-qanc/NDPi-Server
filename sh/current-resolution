#!/usr/bin/env bash

# Reports per-port display/resolution state for the Hub's two independent
# physical outputs:
#   HDMI-1 -> DISPLAY=:0.0 (the Hub's own kiosk dashboard, config/kiosk.service)
#   HDMI-2 -> DISPLAY=:0.1 (a second, independent "Zaphod mode" screen on
#             the SAME Xorg process, showing the AirPlay-to-NDI mirror --
#             see config/systemd/uxplay-*.service /
#             config/xorg/10-hdmi-zaphod.conf)
#
# Every line is emitted as "<key> : <PORT> :: <value>" (list_resolutions'
# own value additionally embeds a second ' :: ' separating a human-readable
# label from the raw mode string) -- hub_fs.js's updateOutputDisplayFiles()
# parses this tagged format directly into each port's own
# output_display_hdmi1_*/output_display_hdmi2_* keys.
#
# Each DISPLAY (:0.0 / :0.1) is queried and parsed independently (rather
# than trusting whatever output name xrandr itself reports) since each
# Zaphod screen is constrained to exactly one physical connector, so
# "whichever output is connected under this screen" IS that port, by
# construction.

parse_xrandr_for_port() {
    local port="$1"
    local xrandr_output="$2"

    echo "$xrandr_output" | awk -v port="$port" '
        /^[^ ]/ {
            active = 0;
            if ($0 ~ / connected/) {
                active = 1;
                print "current_output : " port " :: " port;
            }
            next;
        }
        active && /^[ \t]/ {
            mode = $1;
            print "list_resolutions : " port " :: " mode " " $2 " :: " mode;
            for (i = 2; i <= NF; i++) {
                if ($i ~ /\*/) {
                    rate = $i; gsub(/[*+]/, "", rate);
                    print "current_resolution : " port " :: " mode;
                    print "current_framerate : " port " :: " rate;
                }
                if ($i ~ /\+/) {
                    rate = $i; gsub(/[*+]/, "", rate);
                    print "preferred_resolution : " port " :: " mode;
                    print "preferred_framerate : " port " :: " rate;
                }
            }
        }
    '
}

XRANDR_HDMI1="$(DISPLAY=:0.0 xrandr 2>/dev/null)"
parse_xrandr_for_port "HDMI-1" "$XRANDR_HDMI1"

XRANDR_HDMI2="$(DISPLAY=:0.1 xrandr 2>/dev/null)"
parse_xrandr_for_port "HDMI-2" "$XRANDR_HDMI2"

# EDID (per physical connector -- card1-HDMI-A-1 = HDMI-1, card1-HDMI-A-2 = HDMI-2)
for entry in "HDMI-1:card1-HDMI-A-1" "HDMI-2:card1-HDMI-A-2"; do
    PORT="${entry%%:*}"
    CARD="${entry##*:}"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Manufacturer:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "manufacturer : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Display Product Name:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "model_name : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Model:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "model_number : " p " :: " $2}')"

    echo "$(edid-decode /sys/class/drm/${CARD}/edid | \
        grep -wF 'Display Product Serial Number:' | tr -d "'" | \
        awk -F ':' -v p="$PORT" '{gsub(/^ +| +$/, "", $2); print "sn : " p " :: " $2}')"
done

exit 0
