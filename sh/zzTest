# Logging functions
log_info() {
    echo -e "${B}     INFO ╮${NC}"
    echo -e "${B}          ╰⸺▶ ${INFO}$1${NC}"
}
ext_info() {
    echo -e "${B}          ╰⸺▶ ${INFO}$1${NC}"
}
log_error() {
    echo -e "${R}    ERROR ╮${NC}"
    echo -e "${R}          ╰⸺▶ ${INFO}$1${NC}"
}
ext_error() {
    echo -e "${R}          ╰⸺▶ ${INFO}$1${NC}"
}
log_success() {
    echo -e "${G}  SUCCESS ╮${NC}"
    echo -e "${G}          ╰⸺▶ ${INFO}$1${NC}"
}
ext_success() {
    echo -e "${G}          ╰⸺▶ ${INFO}$1${NC}"
