getNvmVer() {
    ssh "${USER}@${IP}" '
        export NVM_DIR="$HOME/.nvm"
        [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
        nvm -v
    ' 2>/dev/null
}

getDesktopManager_v1() {
    ssh "${USER}@${IP}" \
    "loginctl show-session \$(loginctl | awk '/tty|seat/ {print \$1; exit}') -p Type --value"
}

getDesktopManager_v2() {
    ssh "${USER}@${IP}" \
    "loginctl list-sessions --no-legend | awk 'NR==1 {print \$1}' | xargs -I{} loginctl show-session {} -p Type --value"
}

getDesktopManager_v3() {
    ssh "${USER}@${IP}" 'bash -s' <<'EOF'
session=$(loginctl list-sessions --no-legend | awk 'NR==1 {print $1}')
loginctl show-session "$session" -p Type --value
EOF
}

progress_bar() {
    local duration=$1
    local steps=50
    local sleep_time=$(awk "BEGIN {print $duration/$steps}")

    for ((i=0; i<=steps; i++)); do
        local percent=$(( i * 100 / steps ))

        printf "\r[%-50s] %3d%%" "$(printf '%*s' "$i" | tr ' ' '#')" "$percent"
        sleep "$sleep_time"
    done
    echo
}

wait_for_ssh() {
    local host="$1"
    local user="$2"
    local timeout="${3:-120}"   # max seconds to wait
    local interval=2            # seconds between attempts
    local elapsed=0

    while true; do
        if ssh -o ConnectTimeout=2 \
               -o BatchMode=yes \
               -o StrictHostKeyChecking=no \
               "${user}@${host}" "exit" 2>/dev/null; then
            echo ""
            return 0
        fi

        if (( elapsed >= timeout )); then
            log_error "TIMEOUT"
            ext_error "Took too long to reconnect."
            return 1
        fi

        printf "\rWaiting for Reboot... %ds/%ds" "$elapsed" "$timeout"
        sleep "$interval"
        ((elapsed+=interval))
    done
}

reboot_wait() {
    local host="${1:-$IP}"
    local user="${2:-$USER}"
    local timeout="${3:-180}"
    local interval=2
    local elapsed=0

    echo -e "${B}     INFO ╮${NC}"
    echo -e "${B}          ╰⸺▶ ${INFO}Rebooting Device"

    ssh "${user}@${host}" "sudo reboot"
    sleep 1

    printf  "${B}          ╰⸺▶ ${INFO}Waiting for device online."


    # Phase 1: wait for SSH to accept connections
    while ! ssh -o ConnectTimeout=3 \
                 -o BatchMode=yes \
                 -o StrictHostKeyChecking=no \
                 "${user}@${host}" "exit" 2>/dev/null; do

        printf "."
        sleep "$interval"
        ((elapsed+=interval))

        if (( elapsed >= timeout )); then
            echo -e "${NC}"
            return 1
        fi
    done

    echo -e "${NC}"

    # Reset timer for next phase
    elapsed=0

    # Phase 2: wait for systemd to report fully running
    while true; do
        state=$(ssh -o ConnectTimeout=3 \
                    -o BatchMode=yes \
                    "${user}@${host}" "systemctl is-system-running" 2>/dev/null)

        if [[ "$state" == "running" ]]; then
            return 0
        fi

        sleep "$interval"
        ((elapsed+=interval))

        if (( elapsed >= timeout )); then
            log_error "Systemctl not responding"
            ext_error "Last Known State: $state"
            return 1
        fi
    done
}

activateX11() {
    local target="x11"

    # Check if x11 is already set using all 3 methods.
    local display=$(getDesktopManager_v1)
    if [ "$display" = "$target" ]; then
        return
    fi
    local display=$(getDesktopManager_v2)
    if [ "$display" = "$target" ]; then
        return
    fi
    local display=$(getDesktopManager_v3)
    if [ "$display" = "$target" ]; then
        return
    else
        log_info "Switching to $target"
        ssh "${USER}@${IP}" "sudo raspi-config nonint do_wayland W1"
        reboot_wait
        ext_success "Device ready"
    fi
}

