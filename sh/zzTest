standBy() {

    log_info "Current Node Versions"
    ext_info "    nvm - $(ssh "${USER}@${IP}" "nvm -v")"
    ext_info "Node.js - $(ssh "${USER}@${IP}" "node -v")"
    ext_info "    npm - $(ssh "${USER}@${IP}" "npm -v")"


    echo -e "${INFO}Checking Node Version..."
    if ssh "${USER}@${IP}" "
        node -v
    "; then
        echo -e "${NC}"
    fi
    echo -e "${NC}"

    # Check if nvm is already installed
    if ! ssh "${USER}@${IP}" "
        nvm -v >/dev/null 2>&1
    "; then
        log_info "Installing Node Version Manager..."
        if ! ssh "${USER}@${IP}" "
            set -e
            curl -o- ${NVM_URL} | bash
        "; then
            log_error "Node Version Manager failed to install"
            exit 1
        fi
    fi
    ######
    local output=$(ssh "${USER}@${IP}" "node -v" 2>/dev/null)
    local check="20"

    if [[ $output == *"v$check"* ]]; then
        echo "-- TRUE ${output}"
    else
        echo "-- FALSE ${output}"
    fi
    ######
    local nvmVerChk="$(ssh "${USER}@${IP}" "nvm -v" 2>/dev/null)"
    if [ "$nvmVerChk" != "" ]; then
        echo $nvmVerChk
    fi

    local nodeVerChk="$(ssh "${USER}@${IP}" "node -v" 2>/dev/null)"
    if [ "$nodeVerChk" != "" ]; then
        echo $nodeVerChk
    fi

    local npmVerChk="$(ssh "${USER}@${IP}" "npm -v" 2>/dev/null)"
    if [ "$npmVerChk" != "" ]; then
        echo $npmVerChk
    fi
    #######
    local nvmVerChk="$(ssh "${USER}@${IP}" "nvm -v" 2>/dev/null)"
    if [ "$nvmVerChk" = "" ]; then
        log_info "Installing Node Version Manager..."
        local nvmVerChk="$(ssh "${USER}@${IP}" "npm -v" 2>/dev/null)"
    fi

    if [ "$nvmVerChk" = "" ]; then
        ext_error "Installing Node Version Manager FAILED..."
        exit 1
    else
        ext_success "Node Version Manager (${nvmVerChk}) Installed"
    fi

    echo $(head -n 1 version-git.txt)

}

